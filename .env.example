# Key NAMES only. Copy to .env (gitignored) and fill in, or set these in the environment's
# secrets before a session starts: a running session does not see secrets added later.
# The names are declared in config/kiln.yaml; `kiln doctor` checks them.
#
# In a Claude Code cloud session the proxy injects the OpenAI, Gemini and Langfuse keys, so
# those variables can stay unset there.

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
NEON_DATABASE_URL=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
BRAVE_API_KEY=
